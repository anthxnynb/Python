print("Ingrese el capital inicial:")
CAP = float(input())

# Proceso y cálculos
while CAP < 0:
    print("El capital no puede ser negativo")
    print("Ingrese el capital inicial:")
    CAP = float(input())

print("Ingrese el deposito mensual:")
DEP = float(input())

while DEP < 0:
    print("El deposito no puede ser negativo")
    print("Ingrese el deposito mensual:")
    DEP = float(input())

print("Ingrese el numero de meses:")
N = int(input())

while N <= 0:
    print("El numero de meses debe ser mayor que 0")
    print("Ingrese el numero de meses:")
    N = int(input())

print("Ingrese la tasa mensual de interes (%):")
TASA = float(input())

while TASA < 0:
    print("La tasa no puede ser negativa")
    print("Ingrese la tasa mensual de interes (%):")
    TASA = float(input())

SAL = CAP

for MES in range(1, N + 1):
    SAL = SAL + DEP
    SAL = SAL * (1 + TASA / 100)
    print("Saldo al finalizar el mes ", MES, ": $", SAL)

print("Saldo final: $", SAL)

if __name__ == "__main__":
