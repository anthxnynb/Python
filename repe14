print("Ingrese la cantidad de notas:")
N = int(input())

# Proceso y cálculos
while N <= 0:
    print("La cantidad de notas debe ser mayor que 0")
    print("Ingrese la cantidad de notas:")
    N = int(input())

SUMA = 0

for I in range(1, N + 1):
    print("Ingrese la nota ", I, " (0 a 10):")
    NOTA = float(input())

    while NOTA < 0 or NOTA > 10:
        print("La nota debe estar entre 0 y 10")
        print("Ingrese la nota ", I, " (0 a 10):")
        NOTA = float(input())

    SUMA = SUMA + NOTA

P = SUMA / N

print("El promedio de las notas es: ", P)
