print("Ingrese un numero entero positivo:")
N = int(input())

# Proceso y cálculos
while N <= 0:
    print("El numero debe ser mayor que 0")
    print("Ingrese un numero entero positivo:")
    N = int(input())

SUMA = 0
DIV = 1

while DIV <= N // 2:
    if N % DIV == 0:
        SUMA = SUMA + DIV

    DIV = DIV + 1

if SUMA == N and N > 1:
    print(N, " es un numero perfecto")
else:
    print(N, " no es un numero perfecto")
