print("Promedio de 0 a 10:")
P = float(input())

print("Materias reprobadas:")
R = int(input())

if P < 0 or P > 10 or R < 0:
    print("Datos invalidos")
else:
    # Primero se determina el nivel
    N = 4

    if P >= 9 and R == 0:
        N = 1
    else:
        if P >= 8 and R <= 1:
            N = 2
        else:
            if P >= 7:
                N = 3

    # Luego se presenta la recomendacion
    match N:
        case 1:
            print("Excelente - Continua asi")
        case 2:
            print("Bueno - Refuerza debilidades")
        case 3:
            print("Regular - Necesitas mas estudio")
        case 4:
            print("En riesgo - Busca tutoria")
