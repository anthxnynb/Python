print("Promedio (0 a 10):")
P = float(input())

print("Materias reprobadas:")
R = int(input())

print("Es de primer ciclo? (S/N):")
C = input().strip()

if P < 0 or P > 10 or R < 0 or (C != "S" and C != "N"):
    print("Datos invalidos")
else:
    # Se evalua de mayor a menor porcentaje de beca
    if P >= 9 and R == 0 and C == "S":
        B = 100
    else:
        if P >= 8 and R <= 1:
            B = 70
        else:
            if P >= 7 and R <= 2:
                B = 40
            else:
                B = 0

    print("Porcentaje de beca: ", B, "%")

    if B > 0:
        print("Beca aprobada")
    else:
        print("Beca rechazada")
